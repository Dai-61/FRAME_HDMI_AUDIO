# 08_HDMI_640 : 640x480 HDMI + VGA color bar
set_pin_assignment { clk }   { LOCATION = R7; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { rst_n } { LOCATION = A9; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

set_pin_assignment { hdmi_clk_p } { LOCATION = P1; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment { hdmi_d0_p }  { LOCATION = N1; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment { hdmi_d1_p }  { LOCATION = P4; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment { hdmi_d2_p }  { LOCATION = J3; IOSTANDARD = LVDS33; PULLTYPE = NONE; }

set_pin_assignment { vga_hs } { LOCATION = M14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; SLEWRATE = FAST; }
set_pin_assignment { vga_vs } { LOCATION = P14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; SLEWRATE = FAST; }

set_pin_assignment { vga_r[0] } { LOCATION = H14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; SLEWRATE = FAST; }
set_pin_assignment { vga_r[1] } { LOCATION = H13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; SLEWRATE = FAST; }
set_pin_assignment { vga_r[2] } { LOCATION = H16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; SLEWRATE = FAST; }
set_pin_assignment { vga_r[3] } { LOCATION = G16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; SLEWRATE = FAST; }
set_pin_assignment { vga_r[4] } { LOCATION = H15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; SLEWRATE = FAST; }

set_pin_assignment { vga_g[0] } { LOCATION = G11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; SLEWRATE = FAST; }
set_pin_assignment { vga_g[1] } { LOCATION = J11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; SLEWRATE = FAST; }
set_pin_assignment { vga_g[2] } { LOCATION = K16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; SLEWRATE = FAST; }
set_pin_assignment { vga_g[3] } { LOCATION = K15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; SLEWRATE = FAST; }
set_pin_assignment { vga_g[4] } { LOCATION = J16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; SLEWRATE = FAST; }
set_pin_assignment { vga_g[5] } { LOCATION = J14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; SLEWRATE = FAST; }

set_pin_assignment { vga_b[0] } { LOCATION = J13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; SLEWRATE = FAST; }
set_pin_assignment { vga_b[1] } { LOCATION = K14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; SLEWRATE = FAST; }
set_pin_assignment { vga_b[2] } { LOCATION = J12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; SLEWRATE = FAST; }
set_pin_assignment { vga_b[3] } { LOCATION = K12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; SLEWRATE = FAST; }
set_pin_assignment { vga_b[4] } { LOCATION = L14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; SLEWRATE = FAST; }

set_pin_assignment { led } { LOCATION = B15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

# Hardwood HX4S20 microSD socket, SPI mode:
# SD_D3=SPI_CS, SD_CMD=SPI_MOSI, SD_CLK=SPI_SCK, SD_D0=SPI_MISO.
set_pin_assignment { sd_ncs }  { LOCATION = F13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { sd_mosi } { LOCATION = F14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { sd_dclk } { LOCATION = F15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { sd_miso } { LOCATION = D14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# 4x4 keypad
set_pin_assignment { key_row[0] } { LOCATION = E10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { key_row[1] } { LOCATION = C10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { key_row[2] } { LOCATION = F9;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { key_row[3] } { LOCATION = D9;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

set_pin_assignment { key_col[0] } { LOCATION = E11; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { key_col[1] } { LOCATION = D11; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { key_col[2] } { LOCATION = C11; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { key_col[3] } { LOCATION = F10; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
